# Environment Variables for Pokemon Analyzer Backend

# Google Gemini API Key (Required)
GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key_here

# Server Configuration
PORT=3001
NODE_ENV=production

# Frontend URL for CORS (Required for production)
FRONTEND_URL=https://vaishvan.github.io

# Optional: Custom rate limiting (defaults shown)
# RATE_LIMIT_WINDOW_MS=86400000  # 24 hours in milliseconds
# RATE_LIMIT_MAX_REQUESTS=10     # Maximum requests per window
